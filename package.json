{
    "name": "eslint-plugin-handle-errors",
    "version": "0.5.0",
    "description": "ESLint rules for handling errors",
    "keywords": [
        "eslint",
        "eslintplugin",
        "eslint-plugin",
        "errors",
        "logging"
    ],
    "author": "Maksim Zemskov <maxaz74@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Nodge/eslint-plugin-handle-errors/issues"
    },
    "homepage": "https://github.com/Nodge/eslint-plugin-handle-errors",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nodge/eslint-plugin-handle-errors.git"
    },
    "packageManager": "pnpm@11.22.0",
    "engines": {
        "node": "^22.13 || >=24"
    },
    "types": "./dist/index.d.cts",
    "exports": {
        "import": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
        }
    },
    "files": [
        "*.md",
        "LICENSE",
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "build:watch": "tsdown --watch",
        "lint": "eslint .",
        "fmt": "prettier --write . --log-level error",
        "test": "vitest",
        "typecheck": "tsc --noEmit",
        "changeset": "changeset add",
        "ci:lint": "eslint .",
        "ci:fmt": "prettier --check .",
        "ci:typecheck": "tsc --noEmit",
        "ci:tests": "vitest --run",
        "ci:build": "tsdown",
        "ci:changesets": "changeset status --since=origin/main",
        "ci:version": "changeset version",
        "ci:publish": "pnpm run ci:build && changeset publish"
    },
    "devDependencies": {
        "@changesets/changelog-github": "1.0.0",
        "@changesets/cli": "3.0.1",
        "@eslint/js": "10.0.1",
        "@types/estree": "1.0.9",
        "dedent": "1.7.2",
        "eslint": "10.9.1",
        "eslint-plugin-eslint-plugin": "7.6.2",
        "lefthook": "2.1.12",
        "prettier": "3.9.6",
        "tsdown": "0.22.14",
        "typescript": "6.0.3",
        "typescript-eslint": "8.68.0",
        "vitest": "4.1.11"
    },
    "peerDependencies": {
        "eslint": ">=9"
    }
}
